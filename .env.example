# ── LLM provider — pick ONE ─────────────────────────────────────────────
LLM_PROVIDER=groq              # groq | gemini | ollama | openrouter
# LLM_MODEL=                   # optional; defaults: groq=openai/gpt-oss-120b, gemini=gemini-2.0-flash,
#                              #   ollama=llama3.1, openrouter=meta-llama/llama-3.1-70b-instruct:free

GROQ_API_KEY=
# GOOGLE_API_KEY=              # for LLM_PROVIDER=gemini
# OPENROUTER_API_KEY=          # for LLM_PROVIDER=openrouter
# OLLAMA_HOST=http://localhost:11434   # for LLM_PROVIDER=ollama (no key needed)

# ── Generation settings (optional) ──────────────────────────────────────
# TEMPERATURE=0.0
# MAX_TOKENS=2048
# LLM_TIMEOUT=60
# LLM_MAX_RETRIES=3
LOG_LEVEL=INFO

# ── Live execution (only used with --execute / execute=True) ────────────
# ELASTIC_HOST=https://localhost:9200
# ELASTIC_API_KEY=
# WAZUH_HOST=https://localhost:55000
# WAZUH_USER=wazuh
# WAZUH_PASSWORD=
# SPLUNK_HOST=https://localhost:8089
# SPLUNK_USER=admin
# SPLUNK_PASSWORD=
